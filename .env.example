TMDB_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Optional behavior flags (strings: "true"/"false")
SUPABASE_INSERT_ONLY=false
SCRAPE_INSERT_ONLY=false

# --- self-host pipeline (see selfhost/README.md) ---
SELFHOST_TOP_N=20
SELFHOST_BUDGET_GB=9.5
SELFHOST_MIN_TARGET_MB=400
SELFHOST_MAX_TARGET_MB=1500
SELFHOST_CODEC=hevc
SELFHOST_PRESET=medium
SELFHOST_AUDIO_BITRATE=128k
SELFHOST_AUDIO_CHANNELS=2
SELFHOST_WORK_DIR=/mnt/selfhost
SELFHOST_LOG_LEVEL=info

R2_ENDPOINT=https://05378e4f5f3be1bb3e7afa235f590b09.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=filimehome
R2_PREFIX=movies
R2_PUBLIC_BASE_URL=
# R2_PUBLIC_BASE_URL: leave empty and the pipeline derives S3-style URLs.
# For those to be reachable by end users, enable R2 "Public access" on the
# bucket (free *.r2.dev subdomain, no custom domain needed) and then set this
# to e.g. https://pub-<HASH>.r2.dev

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- agasobanuyenow enrich/insert scraper (npm run scrape3) ---
# "watch" = cheap high-frequency pass over the newest catalog window
# (skips movies already resolved + series whose episode badge didn't change);
# a full delta scan runs automatically every AGNOW_FULL_SCAN_HOURS.
AGNOW_INSERT_NEW=true
AGNOW_WATCH=true
AGNOW_WATCH_PAGES=3
AGNOW_FULL_SCAN_HOURS=24
AGNOW_DELAY_MS=350
AGNOW_MAX_PAGES=25

# --- rebamovie enrich/insert scraper (npm run scrape4, Kinyarwanda "rn") ---
# Delta runs re-resolve items older than REBA_REFRESH_HOURS (Wix-signed video
# URLs expire in ~24h) so stored links stay fresh. A full re-scan runs
# automatically every REBA_FULL_SCAN_HOURS.
REBA_LANGUAGE_CODE=rn
REBA_INSERT_NEW=true
REBA_DOWNLOADS=true
REBA_DELAY_MS=120
REBA_REFRESH_HOURS=6
REBA_FULL_SCAN_HOURS=24
REBA_DL_MIN_GAP_MS=500
REBA_BATCH_SIZE=50
REBA_MAX_EPISODES=200
